# Build outputs
markedit.exe
markedit.pdb
markedit.res
tests/test_parser.exe
tests/test_parser.pdb
/dist/
/dist.previous/
/dest/
/Scintilla.dll
/WebView2Loader.dll
/Lexilla.lib
/Lexilla.pdb

# Lexilla is linked straight into markedit.exe (see build.bat); its sources
# are compiled to same-named .o files in the project root before linking.
# markedit.lib is lld-link's side-effect companion import lib, produced
# because Lexilla.cxx unconditionally __declspec(dllexport)s its API even
# when compiled into an exe rather than a DLL.
/*.o
/lexilla-objects.rsp
/markedit.lib

# premake5-generated Makefiles (premake5.lua is the checked-in source)
/build/

# Inno Setup's default output directory (markedit.iss is the checked-in source)
/Output/

# WebView2 browser profile/cache that builds before it moved to
# %LOCALAPPDATA%\MarkEdit\WebView2 created beside markedit.exe
webview2_data/

# User settings persisted at runtime
markedit.ini

# Keep the vendored Scintilla headers, runtime, version, and licence; ignore the
# upstream source/documentation tree because MarkEdit does not build it.
third_party/scintilla/*
!third_party/scintilla/include/
!third_party/scintilla/include/**
!third_party/scintilla/bin/
third_party/scintilla/bin/*
!third_party/scintilla/bin/Scintilla.dll
!third_party/scintilla/License.txt
!third_party/scintilla/version.txt

# The dynamic-loader import library is used; the static loader is not.
third_party/webview2/x64/WebView2LoaderStatic.lib
.claude/settings.json
.claude/
