# Build outputs. Both builds link tinkeredit.exe under build\ (build\zig or
# build\bin) and stage it, with the runtime DLLs, only into dist\.
tinkeredit.exe
tinkeredit.pdb
/dist/
/dist.previous/
/Lexilla.lib
/Lexilla.pdb

# build.bat's intermediates and exe (build\zig, including the linker's
# side-effect tinkeredit.lib), premake's exe (build\bin), the test programs
# test.bat and premake build (build\tests), and premake5-generated Makefiles
# and objects (premake5.lua is the checked-in source)
/build/

# Inno Setup's default output directory (tinkeredit.iss is the checked-in source)
/Output/

# WebView2 browser profile/cache that builds before it moved to
# %LOCALAPPDATA%\TinkerEditor\WebView2 created beside tinkeredit.exe
webview2_data/

# User settings persisted at runtime
tinkeredit.ini
/portable.mode
/portable-data/

# clangd's compilation database is generated by gen_compdb.ps1
/compile_commands.json
/.cache/

# Keep the vendored Scintilla headers, runtime, version, and licence; ignore the
# upstream source/documentation tree because Tinker Editor does not build it.
third_party/scintilla/*
!third_party/scintilla/include/
!third_party/scintilla/include/**
!third_party/scintilla/bin/
third_party/scintilla/bin/*
!third_party/scintilla/bin/Scintilla.dll
!third_party/scintilla/License.txt
!third_party/scintilla/version.txt

# The dynamic-loader import library is used; the static loader is not.
third_party/webview2/x64/WebView2LoaderStatic.lib

.claude/

# Interrupted atomic writes
*.tinkeredit-*.tmp
/tests/*
!/tests/*.c
!/tests/*.ps1
/test.bat
