# Build outputs
markedit.exe
markedit.pdb
/dist/
/dist.previous/
/dest/
/Scintilla.dll
/WebView2Loader.dll
/Lexilla.lib
/Lexilla.pdb

# markedit.lib is the linker's side-effect import lib, produced because
# Lexilla.cxx unconditionally __declspec(dllexport)s its API even when
# compiled into an exe rather than a DLL. build.bat redirects it into
# build\zig; a premake build may still write it beside markedit.exe.
/markedit.lib

# build.bat's intermediates (build\zig) and premake5-generated Makefiles and
# objects (premake5.lua is the checked-in source)
/build/

# Inno Setup's default output directory (markedit.iss is the checked-in source)
/Output/

# WebView2 browser profile/cache that builds before it moved to
# %LOCALAPPDATA%\MarkEdit\WebView2 created beside markedit.exe
webview2_data/

# User settings persisted at runtime
markedit.ini

# clangd's compilation database is generated by gen_compdb.ps1
/compile_commands.json
/.cache/

# Keep the vendored Scintilla headers, runtime, version, and licence; ignore the
# upstream source/documentation tree because MarkEdit does not build it.
third_party/scintilla/*
!third_party/scintilla/include/
!third_party/scintilla/include/**
!third_party/scintilla/bin/
third_party/scintilla/bin/*
!third_party/scintilla/bin/Scintilla.dll
!third_party/scintilla/License.txt
!third_party/scintilla/version.txt

# The dynamic-loader import library is used; the static loader is not.
third_party/webview2/x64/WebView2LoaderStatic.lib

.claude/

# test.bat builds each test program beside its source
/tests/*.exe
/tests/*.pdb

# Interrupted atomic writes
*.markedit-*.tmp
