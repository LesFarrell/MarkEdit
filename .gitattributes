* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

*.c text eol=lf
*.h text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.manifest text eol=lf
*.rc text eol=lf
*.rsp text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.dll binary
*.exe binary
*.ico binary
*.lib binary
*.png binary
*.jpg binary
*.gif binary

# Generated by Microsoft's MIDL tool and intentionally contains trailing spaces.
third_party/webview2/include/WebView2.h -text whitespace=-blank-at-eol,-blank-at-eof
mermaid.min.js -text whitespace=-blank-at-eol,-blank-at-eof
github-markdown.css whitespace=-blank-at-eof

# Preserve the pinned upstream cmark-gfm files verbatim.
third_party/cmark-gfm/** -text whitespace=-blank-at-eol,-blank-at-eof
