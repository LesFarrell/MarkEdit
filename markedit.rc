#include <windows.h>

#define IDI_APPICON 1
#define IDR_DEFAULT_MENUS 2
#define IDR_BUILTIN_FORMATTING_BASE 3
#define IDR_HELP_MARKDOWN 4
#define IDR_HELP_SHORTCUTS 5
#define IDR_BUILTIN_FORMATTING_JSON 6
#define IDR_BUILTIN_FORMATTING_TABLES 7
#define IDR_BUILTIN_FORMATTING_TEXT 8

IDI_APPICON ICON "markedit.ico"
IDR_DEFAULT_MENUS RCDATA "src/menus.lua"
IDR_BUILTIN_FORMATTING_BASE RCDATA "src/lua/formatting_base.lua"
IDR_BUILTIN_FORMATTING_JSON RCDATA "src/lua/formatting_json.lua"
IDR_BUILTIN_FORMATTING_TABLES RCDATA "src/lua/formatting_tables.lua"
IDR_BUILTIN_FORMATTING_TEXT RCDATA "src/lua/formatting_text.lua"
IDR_HELP_MARKDOWN RCDATA "src/help/markdown-reference.md"
IDR_HELP_SHORTCUTS RCDATA "src/help/keyboard-shortcuts.lua"
1 24 "markedit.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Les Farrell\0"
            VALUE "FileDescription", "MarkEdit Markdown editor\0"
            VALUE "FileVersion", "1.0.0\0"
            VALUE "InternalName", "markedit\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Les Farrell\0"
            VALUE "OriginalFilename", "markedit.exe\0"
            VALUE "ProductName", "MarkEdit\0"
            VALUE "ProductVersion", "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
